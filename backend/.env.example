# Application identity
IOT_API_APP_NAME=ForgeSight Industrial IoT API
IOT_API_SERVICE_NAME=iot-platform-api
IOT_API_VERSION=0.2.0
IOT_API_ENVIRONMENT=local
IOT_API_DEBUG=false
IOT_API_DOCS_ENABLED=true
IOT_API_API_V1_PREFIX=/api/v1

# HTTP boundary (JSON arrays are recommended for deployment systems)
IOT_API_CORS_ALLOWED_ORIGINS=["http://localhost:4173"]
IOT_API_CORS_ALLOW_CREDENTIALS=true
IOT_API_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]

# Observability
IOT_API_LOG_LEVEL=INFO

# AWS resource isolation
IOT_API_AWS_REGION=ap-south-1
IOT_API_AWS_RESOURCE_PREFIX=forgesight-local
# LocalStack only; leave empty in AWS environments.
IOT_API_AWS_ENDPOINT_URL=

# Production must reference a Secrets Manager signing-key secret.
# Never place key material, tokens, passwords, or AWS credentials in this file.
IOT_API_JWT_SIGNING_KEY_SECRET_ARN=

# Authentication policy. Production signing material is loaded from the secret above.
IOT_API_JWT_ISSUER=https://identity.forgesight.example
IOT_API_JWT_AUDIENCE=forgesight-api
IOT_API_JWT_ALGORITHM=ES256
IOT_API_JWT_ACCESS_TOKEN_TTL_SECONDS=900
IOT_API_JWT_CLOCK_SKEW_SECONDS=30
IOT_API_REFRESH_TOKEN_TTL_SECONDS=2592000
IOT_API_REFRESH_TOKEN_SHORT_TTL_SECONDS=86400
IOT_API_PASSWORD_RESET_TOKEN_TTL_SECONDS=900
IOT_API_REFRESH_COOKIE_NAME=forgesight_refresh
IOT_API_REFRESH_COOKIE_SECURE=false
IOT_API_REFRESH_COOKIE_SAME_SITE=strict

# Application throttling complements AWS WAF and uses the Phase 3 persistence adapter in AWS.
IOT_API_LOGIN_RATE_LIMIT=10
IOT_API_LOGIN_RATE_WINDOW_SECONDS=60
IOT_API_LOGIN_FAILURE_LIMIT=5
IOT_API_LOGIN_FAILURE_WINDOW_SECONDS=300
IOT_API_LOGIN_LOCKOUT_SECONDS=900
IOT_API_PASSWORD_RESET_RATE_LIMIT=5
IOT_API_PASSWORD_RESET_RATE_WINDOW_SECONDS=300
